# Bratadeep — CoinDCX Phase-1 PAPER bot
# Copy to .env and edit. Process env vars override these.

# --- paper account ---
PAPER_BANKROLL_INR=100000
SCAN_INTERVAL_SEC=120
PAIRS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT

# --- Kelly sizing (hard-capped at 6% even if you raise KELLY_CAP) ---
KELLY_CAP=0.06
HALF_KELLY=true
KELLY_FRACTION=0.5
KELLY_PRIOR_P=0.52
KELLY_PRIOR_B=1.15
KELLY_MIN_TRADES=10

# --- risk ---
MAX_DAILY_LOSS_PCT=0.03
MAX_OPEN_POSITIONS=2
KILL_FILE=data/KILL

# --- CoinDCX-ish taker fee (base VIP ~20 bps) + 18% GST on the fee ---
FEE_BPS=20
FEE_GST_PCT=18
SLIPPAGE_BPS=1

# --- strategy: short-horizon momentum + volume filter ---
CANDLE_INTERVAL=1m
CANDLE_LIMIT=60
MOM_LOOKBACK=15
MOM_ENTRY_RET=0.0025
MOM_EXIT_RET=0.0004
MOM_VOLUME_MULT=1.2
MOM_STOP_PCT=0.004
MOM_TAKE_PCT=0.006
MOM_MAX_HOLD_BARS=12
ALLOW_SHORTS=false

# --- data ---
DATA_SOURCE=live
# DATA_SOURCE=fixture
# FIXTURE_PATH=fixtures/synthetic_momentum.json
USDTINR_FALLBACK=99.5
COINDCX_BASE_URL=https://api.coindcx.com
USE_ORDERBOOK=false
LEDGER_PATH=data/ledger.sqlite

# --- LIVE TRADING MUST STAY OFF (Phase-1 will refuse to start if these are set) ---
BROKER=paper
ARM_LIVE_TRADING=false
LIVE_CONFIRM=
COINDCX_API_KEY=
COINDCX_API_SECRET=
